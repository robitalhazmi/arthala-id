# =============================================================================
# Arthala ID — by Robit Al Hazmi
# Environment variable template. Copy to `.env` for local development:
#     cp .env.example .env
# Defaults below target the OFFLINE local sandbox (infra/docker/docker-compose.local.yml).
# Production values live ONLY in GitHub Repository Secrets and Coolify Secrets.
# NEVER commit a real `.env` file.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# local | ci | prod
APP_ENV=local
LOG_LEVEL=INFO

# --- Local sandbox container credentials (docker-compose.local.yml) ----------
POSTGRES_USER=arthala
POSTGRES_PASSWORD=password
POSTGRES_DB=arthala
MINIO_ROOT_USER=arthala
MINIO_ROOT_PASSWORD=password

# --- Serving database (local Postgres 16 emulating Neon) ---------------------
# Prod (Neon): postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require
DATABASE_URL=postgresql://arthala:password@localhost:5432/arthala

# --- Lakehouse object storage (local MinIO emulating Cloudflare R2) ----------
# Prod (R2): https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=arthala
R2_SECRET_ACCESS_KEY=password
R2_BUCKET=arthala-lakehouse
R2_REGION=auto

# --- Streaming (local Redpanda emulating Aiven Kafka) -------------------------
# Prod (Aiven): <service>.aivencloud.com:<port> with SSL
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# PLAINTEXT (local) | SSL (Aiven)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SSL_CA=
KAFKA_SSL_CERT=
KAFKA_SSL_KEY=
KAFKA_CONSUMER_GROUP=arthala-worker
KAFKA_TOPIC_TICKS=idx.ticks.raw
KAFKA_TOPIC_DISCLOSURES=idx.disclosures.raw
KAFKA_TOPIC_ALERTS=alerts.dispatch
KAFKA_TOPIC_SUBSCRIPTIONS=user.subscription.updated

# --- MLOps --------------------------------------------------------------------
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_ARTIFACT_ROOT=s3://arthala-lakehouse/mlflow-artifacts
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# --- Telegram bot (@ArthalaIDBot) ---------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_LINK_TOKEN_TTL_SECONDS=900

# --- Payments (Mayar.id QRIS) -------------------------------------------------
MAYAR_WEBHOOK_SECRET=
MAYAR_PRO_PAYMENT_URL=

# --- Observability (Grafana Cloud Free via Grafana Alloy) ---------------------
GRAFANA_PROM_REMOTE_WRITE_URL=
GRAFANA_PROM_USERNAME=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USERNAME=
GRAFANA_CLOUD_API_TOKEN=

# --- API ----------------------------------------------------------------------
API_CORS_ORIGINS=http://localhost:3000

# --- Frontend (apps/web — Cloudflare Pages / Vercel) --------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAYAR_PRO_URL=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=ArthalaIDBot
